# Copy this file to .env and fill it in (run_windows.bat makes the copy on the first run).
# .env holds keys: it is in .gitignore, never commit it. Restart the dashboard after editing.

# --- LLM: keep ONE of the three blocks (the model must accept images) ---------------------------------------------

# Option 1: an OpenAI-compatible server (vLLM, LM Studio, Ollama...), e.g. Qwen.
# In Docker, "localhost" is the container itself: for a server on the same machine use host.docker.internal.
LLM_PROVIDER=vllm
LLM_URL=http://YOUR-LLM-SERVER:1234/v1/chat/completions
LLM_API_KEY=EMPTY
LLM_MODEL=Qwen/Qwen3.8-27B

# Option 2: OpenAI
# LLM_PROVIDER=openai
# LLM_URL=https://api.openai.com/v1/chat/completions
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o

# Option 3: Anthropic (Claude)
# LLM_PROVIDER=anthropic
# LLM_URL=https://api.anthropic.com
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=medium          # low | medium | high | xhigh | max

# Parallel LLM calls (lower this for paid APIs with low rate limits)
LLM_WORKERS=4

# --- Dashboard port (with Docker: the port on the host machine) ---------------------------------------------------
DASHBOARD_PORT=8765

# --- Speech-to-text: tiny | base | small | medium (bigger = slower but better, "small" for non-English videos) -----
WHISPER_MODEL=base

# --- Optional -----------------------------------------------------------------------------------------------------
# Existing Whisper transcripts, one <video_id>.json per video: {"segments": [{"id": 0, "start": 0.0, "end": 4.2, "text": "..."}]}
# TRANSCRIPTS_DIR=/path/to/transcripts

# If YouTube blocks downloads ("Sign in to confirm you're not a bot"), sign in with ONE of these.
# Use a spare Google account: YouTube can flag accounts that download a lot.
#  - read the login from a browser on this computer (Windows): firefox works best; chrome/edge must be closed
# YT_COOKIES_FROM_BROWSER=firefox
#  - or a cookies.txt exported from the browser (also works in Docker); keep it outside the project
# YT_COOKIES=/path/to/cookies.txt

# Docker on Linux: user and group that own the files in output/ and work/ (run "id" to see yours)
# PUID=1000
# PGID=1000
